<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox maxWidth="1.7976931348623157E308" minWidth="0.0" prefWidth="800.0" spacing="18.0" styleClass="product-management-root" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label styleClass="page-title" text="Product Management" />
      <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" minWidth="0.0" spacing="10.0">
         <children>
            <TextField fx:id="productSearchField" maxWidth="1.7976931348623157E308" minWidth="0.0" prefHeight="40.0" promptText="Search by name or brand..." styleClass="input-field" HBox.hgrow="ALWAYS" />
            <Button fx:id="addProductButton" minWidth="-Infinity" mnemonicParsing="false" prefHeight="40.0" styleClass="primary-button" text="+ Add Product" />
         </children>
      </HBox>
      <TableView fx:id="productsTable" maxWidth="1.7976931348623157E308" minHeight="180.0" minWidth="0.0" prefHeight="350.0" VBox.vgrow="NEVER">
        <columns>
            <TableColumn fx:id="productNameColumn" prefWidth="75.0" text="Product" />
          <TableColumn fx:id="brandColumn" prefWidth="75.0" text="Brand" />
          <TableColumn fx:id="categoryColumn" prefWidth="75.0" text="Category" />
            <TableColumn fx:id="priceColumn" prefWidth="75.0" text="Price" />
            <TableColumn fx:id="stockColumn" prefWidth="75.0" text="Stock" />
            <TableColumn fx:id="actionColumn" prefWidth="75.0" text="Action" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
