<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="0.0" prefWidth="750.0" spacing="18.0" styleClass="employee-root" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label styleClass="page-title" text="Employee Management" />
      <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" minWidth="0.0" spacing="10.0">
         <children>
            <TextField fx:id="employeeSearchField" maxWidth="1.7976931348623157E308" minWidth="0.0" prefHeight="40.0" promptText="Search employee..." styleClass="input-field" HBox.hgrow="ALWAYS" />
            <Button fx:id="addCashierButton" minHeight="-Infinity" mnemonicParsing="false" prefHeight="40.0" styleClass="primary-button" text="+ Add Cashier" />
         </children>
      </HBox>
      <TableView fx:id="employeesTable" maxWidth="1.7976931348623157E308" minHeight="180.0" minWidth="0.0" prefHeight="350.0" VBox.vgrow="NEVER">
        <columns>
          <TableColumn fx:id="nameColumn" prefWidth="75.0" text="Name" />
          <TableColumn fx:id="emailColumn" prefWidth="75.0" text="Email" />
            <TableColumn fx:id="phoneColumn" prefWidth="75.0" text="Phone" />
            <TableColumn fx:id="roleColumn" prefWidth="75.0" text="Role" />
            <TableColumn fx:id="actionColumn" prefWidth="75.0" text="Action" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
