<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Spinner?>
<HBox alignment="CENTER_LEFT" minWidth="0.0" spacing="12.0"
      stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sk.upjs.perfumestore.controller.cartControllers.CartItemController">
    <children>
        <VBox spacing="5.0">
            <children>
                <Label fx:id="productNameLabel" text="Product Name">
                    <styleClass>
                        <String fx:value="brand-title" />
                        <String fx:value="section-title" />
                    </styleClass>
                </Label>
                <Label fx:id="priceLabel" styleClass="product-price" text="€89 × 1" textFill="WHITE" />
            </children>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Spinner fx:id="quantitySpinner" editable="true" prefWidth="96.0" minWidth="96.0"
                 prefHeight="38.0" minHeight="38.0" styleClass="quantity-spinner" />
        <Button fx:id="removeButton" mnemonicParsing="false" onAction="#removeButtonOnAction"
                styleClass="danger-button" text="Remove" />
    </children>
</HBox>