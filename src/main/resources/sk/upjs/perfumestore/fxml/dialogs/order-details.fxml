<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxWidth="Infinity" spacing="18" styleClass="orders-root" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sk.upjs.perfumestore.controller.MyOrdersControllers.OrdersDetailsContorller">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <children>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>
                <Label styleClass="page-title" text="Order Details" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="backButton" onAction="#backButtonOnAction" styleClass="primary-button" text="Back to Orders" />
            </children>
        </HBox>

        <Label fx:id="orderIdLabel" text="Order ID:" textFill="WHITE" />

        <Label fx:id="orderDateLabel" text="Date:" textFill="WHITE" />

        <Label fx:id="orderStatusLabel" text="Status:" textFill="WHITE" />

        <Label fx:id="orderTypeLabel" text="Order type:" textFill="WHITE" />

        <Label styleClass="section-title" text="Ordered Products" />

        <TableView fx:id="orderItemsTable" maxWidth="Infinity" VBox.vgrow="NEVER">

            <columns>
                <TableColumn fx:id="productColumn" prefWidth="220" text="Product" />

                <TableColumn fx:id="quantityColumn" prefWidth="100" text="Quantity" />

                <TableColumn fx:id="unitPriceColumn" prefWidth="120" text="Unit Price" />

                <TableColumn fx:id="subtotalColumn" prefWidth="120" text="Subtotal" />
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

        </TableView>

        <Label fx:id="totalPriceLabel" styleClass="section-title" text="Total:" />

    </children>
</VBox>
