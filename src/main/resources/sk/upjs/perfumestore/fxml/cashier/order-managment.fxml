<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox maxWidth="1.7976931348623157E308" minWidth="0.0" prefWidth="750.0" spacing="16.0" styleClass="order-management-root" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label styleClass="page-title" text="Order Management" />
      <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" minWidth="0.0" spacing="10.0">
         <children>
            <TextField fx:id="orderSearchField" maxWidth="1.7976931348623157E308" minWidth="0.0" prefHeight="40.0" promptText="Search order ID..." styleClass="input-field" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="statusFilterComboBox" prefHeight="40.0" prefWidth="150.0" promptText="All statuses" styleClass="filter-combo" />
         </children>
      </HBox>
      <TableView fx:id="ordersTable" maxWidth="1.7976931348623157E308" minHeight="180.0" minWidth="0.0" prefHeight="300.0" VBox.vgrow="NEVER">
        <columns>
            <TableColumn fx:id="orderIdColumn" prefWidth="75.0" text="Order ID" />
          <TableColumn fx:id="customerColumn" prefWidth="75.0" text="Customer" />
          <TableColumn fx:id="dateColumn" prefWidth="75.0" text="Date" />
            <TableColumn fx:id="statusColumn" prefWidth="75.0" text="Status" />
            <TableColumn fx:id="totalColumn" prefWidth="75.0" text="Total" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <VBox maxWidth="1.7976931348623157E308" minWidth="0.0" spacing="12.0" styleClass="order-section">
         <children>
            <Label styleClass="section-title" text="Selected Order" />
            <Label fx:id="selectedOrderLabel" styleClass="muted-label" text="Select an order to manage" />
            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" minWidth="0.0" spacing="10.0">
               <children>
                  <ComboBox fx:id="newStatusComboBox" maxWidth="1.7976931348623157E308" minWidth="0.0" prefHeight="40.0" promptText="New Status" styleClass="filter-combo" HBox.hgrow="ALWAYS" />
                  <Button fx:id="updateStatusButton" minWidth="-Infinity" mnemonicParsing="false" prefHeight="40.0" styleClass="primary-button" text="Update Status" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
      </VBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
