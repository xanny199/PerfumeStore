<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<VBox maxWidth="1.7976931348623157E308" minWidth="0.0" prefWidth="800.0" spacing="20.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label styleClass="page-title" text="Shopping Cart" />
      <VBox fx:id="cartItemsContainer" spacing="10.0" styleClass="checkout-section">
         <children>
            <HBox alignment="CENTER_LEFT" minWidth="0.0" spacing="12.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Product Name">
                           <styleClass>
                              <String fx:value="brand-title" />
                              <String fx:value="section-title" />
                           </styleClass>
                        </Label>
                        <Label styleClass="product-price" text="€89 × 1" textFill="WHITE" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" styleClass="danger-button" text="Remove" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </VBox>
      <VBox spacing="12.0" styleClass="checkout-section">
         <children>
            <Label styleClass="section-title" text="Delivery Address" />
            <ComboBox fx:id="deliveryAddressComboBox" maxWidth="1.7976931348623157E308" minWidth="0.0" prefHeight="50.0" promptText="Select address..." styleClass="filter-combo" />
            <Button mnemonicParsing="false" styleClass="app-link-button" text="+ Add Address" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
      <VBox spacing="15.0" styleClass="checkout-section">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="section-title" text="Total" />
                  <Region styleClass="section-title" HBox.hgrow="ALWAYS" />
                  <Label fx:id="totalLabel" styleClass="product-price" text="€89.00" />
               </children>
            </HBox>
            <Button fx:id="placeOrderButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="45.0" styleClass="primary-button" text="Place Order" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
