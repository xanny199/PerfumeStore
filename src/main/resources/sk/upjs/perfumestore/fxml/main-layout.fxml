<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="700.0" prefWidth="1100.0" styleClass="main-layout" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox prefHeight="70.0" spacing="15.0" styleClass="app-header" BorderPane.alignment="CENTER_LEFT">
         <children>
            <Label styleClass="brand-title" text="Perfume Store" />
            <Region maxWidth="1.7976931348623157E308" prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" prefHeight="40.0" styleClass="secondary-button" text="Profile" />
            <Button mnemonicParsing="false" prefHeight="40.0" styleClass="secondary-button" text="Logout" />
         </children>
         <padding>
            <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
         </padding>
      </HBox>
   </top>
   <left>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" minHeight="0.0" pannable="true" prefWidth="215.0" styleClass="sidebar-scroll" BorderPane.alignment="TOP_CENTER">
         <content>
            <VBox minWidth="-Infinity" spacing="10.0" styleClass="app-sidebar">
               <children>
                  <Button fx:id="productsButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#productsButtonOnAction" prefHeight="42.0" styleClass="nav-button" text="Products" />
                  <Button fx:id="cartButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cartButtonOnAction" prefHeight="42.0" styleClass="nav-button" text="Cart" />
                  <Button fx:id="myOrdersButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#myOrdersButtonOnAction" prefHeight="42.0" styleClass="nav-button" text="My Orders" />
                  <Button fx:id="cashRegisterButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cashRegisterButtonOnAction" prefHeight="42.0" styleClass="nav-button" text="Cash Register" />
                  <Button fx:id="manageProductsButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#manageProductsButtonOnAction" prefHeight="42.0" styleClass="nav-button" text="Manage Products" />
                  <Button fx:id="stockButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#stockButtonOnAction" prefHeight="42.0" styleClass="nav-button" text="Stock" />
                  <Button fx:id="ordersButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#ordersButtonOnAction" prefHeight="42.0" styleClass="nav-button" text="Order Managment" />
                  <Button fx:id="statisticsButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#statisticsButtonOnAction" prefHeight="42.0" styleClass="nav-button" text="Statistics" />
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </left>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" prefHeight="200.0" prefWidth="200.0" styleClass="app-scroll" BorderPane.alignment="CENTER">
         <content>
            <StackPane fx:id="contentPane" alignment="TOP_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0.0" styleClass="content-area">
               <children>
                  <Label text="Welcome to PerfumeStore" />
               </children>
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </padding>
            </StackPane>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
