<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minWidth="0.0" prefWidth="750.0" spacing="18.0" styleClass="orders-root" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sk.upjs.perfumestore.controller.MyOrdersControllers.MyOrdersController">
   <children>
      <Label styleClass="page-title" text="My Orders" />
      <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" minWidth="0.0" spacing="10.0">
         <children>
            <Label styleClass="section-title" text="Your order history" />
            <Region HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="allStatusesCombox" prefHeight="38.0" prefWidth="155.0" promptText="All statuses" styleClass="filter-combo" />
            <Button fx:id="resetStatusCombox" mnemonicParsing="false" onAction="#resetStatusComboxOnAction" prefHeight="38.0" styleClass="primary-button" text="Reset" />
         </children>
      </HBox>
      <TableView fx:id="ordersTable" maxWidth="1.7976931348623157E308" minWidth="0.0" styleClass="table-cell" stylesheets="@../../css/style.css" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="orderIdColumn" prefWidth="75.0" text="Order ID" />
            <TableColumn fx:id="dateColumn" prefWidth="75.0" text="Date" />
            <TableColumn fx:id="statusColumn" prefWidth="75.0" text="Status" />
            <TableColumn fx:id="actionColumn" prefWidth="75.0" text="Action" />
            <TableColumn fx:id="totalColumn" prefWidth="75.0" text="Total" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
