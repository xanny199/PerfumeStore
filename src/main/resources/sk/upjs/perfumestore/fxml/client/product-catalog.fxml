<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0.0" prefWidth="850.0" spacing="16.0" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sk.upjs.perfumestore.controller.ProductCatalogControllers.ProductCatalogController">
   <children>
      <HBox alignment="CENTER_LEFT" minWidth="0.0" prefHeight="45.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Label styleClass="page-title" text="Product Catalog" />
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Label fx:id="productCountLabel" styleClass="text-secondary" text="0 products" />
         </children>
      </HBox>
      <TextField fx:id="searchField" maxWidth="1.7976931348623157E308" minWidth="0.0" prefHeight="45.0" promptText="Search by product or brand..." styleClass="input-field" />
      <FlowPane hgap="10.0" maxWidth="1.7976931348623157E308" minWidth="0.0" vgap="10.0">
         <children>
            <ComboBox fx:id="categoryComboBox" prefHeight="40.0" prefWidth="175.0" promptText="Category" styleClass="filter-combo" />
            <ComboBox fx:id="brandComboBox" prefHeight="40.0" prefWidth="175.0" promptText="Brand" styleClass="filter-combo" />
            <ComboBox fx:id="audienceComboBox" prefHeight="40.0" prefWidth="175.0" promptText="Audience" styleClass="filter-combo" />
            <ComboBox fx:id="sortComboBox" prefHeight="40.0" prefWidth="175.0" promptText="Sort" styleClass="filter-combo" />
            <Button fx:id="resetFiltersButton" mnemonicParsing="false" onAction="#resetFiltersOnAction" prefHeight="40.0" styleClass="primary-button" text="Reset" />
         </children>
      </FlowPane>
      <FlowPane fx:id="productFlowPane" hgap="20.0" maxWidth="1.7976931348623157E308" minWidth="0.0" rowValignment="BASELINE" vgap="20.0" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
